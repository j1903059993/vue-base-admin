{
  "name": "vue-base-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern, reusable Vue 3 admin template built with TypeScript, Ant Design Vue and ECharts.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueuse/core": "^13.9.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.19.0"
}
